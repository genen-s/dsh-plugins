{
  "name": "dsh-plugin-quick-notes",
  "version": "1.0.0",
  "type": "module",
  "description": "Quick-notes floating panel for dsh web: timestamped entries, clock, alarms with flashing reminder, API prices & balances, day/week/month/year grouping.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-ui",
    "quick-notes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genen-s/dsh-plugins.git",
    "directory": "quick-notes"
  },
  "homepage": "https://github.com/genen-s/dsh-plugins/tree/main/quick-notes",
  "bugs": {
    "url": "https://github.com/genen-s/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
